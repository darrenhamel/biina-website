{
  "name": "biina",
  "version": "0.1.0",
  "private": true,
  "description": "BIINA.ai monorepo — marketing site (Astro) + product app (Next.js) + AI gateway",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:marketing": "npm run dev -w apps/marketing",
    "build": "npm run build -w apps/web",
    "build:marketing": "npm run build -w apps/marketing",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test -w apps/web",
    "db:generate": "npm run db:generate -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/web",
    "db:push": "npm run db:push -w apps/web",
    "db:seed": "npm run db:seed -w apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}
