# ==========================================================================
# BIINA.ai — example environment. Copy to `.env` and fill in.
# `.env*` files are git-ignored. NEVER commit real secrets.
# All AI provider credentials are SERVER-SIDE ONLY and never reach the browser.
# ==========================================================================

# ---- Core ----
NODE_ENV=development

# ---- Database (Postgres) ----
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://biina:biina@localhost:5432/biina

# ---- Auth ----
# Used to sign/verify sessions. Generate a long random value for real envs:
#   openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string

# ---- App URLs & email (Phase 6 — identity) ----
# Absolute base URL of the product app. Used to build verification / reset /
# invitation links in emails. If unset, links are derived from the request host.
# APP_URL=https://app.biina.ai

# Email provider abstraction. Identity flows depend only on the interface, never
# on a specific vendor. 'dev' logs a REDACTED email server-side (no real sending)
# and, outside production, surfaces the action link for local testing.
# Future adapters (smtp / resend / ses) drop in without touching callers.
EMAIL_PROVIDER=dev
# Safety valve: the dev provider and dev-link API responses hide token-bearing
# links in production. Set to 'true' ONLY in a trusted staging env to expose them.
# EMAIL_DEV_LINKS=false

# ---- AI Gateway ----
# Which provider the gateway uses by default:
#   mock              — built-in development stub (no external services; zero-config default)
#   ollama            — local models via Ollama (Phase 2). Requires Ollama running.
#   openai-compatible — remote OpenAI-compatible endpoint, e.g. vLLM on RunPod (Phase 3).
# Switching this value is the ONLY change needed to move local ↔ cloud. No frontend change.
AI_DEFAULT_PROVIDER=mock
# Optional. Logical model id from the registry:
#   biina-dev = mock · biina-local = ollama · biina-general = openai-compatible
# If unset, the gateway picks the first enabled model for AI_DEFAULT_PROVIDER.
# AI_DEFAULT_MODEL=biina-dev

# Optional global outer request timeout (ms). Providers also enforce their own.
# AI_REQUEST_TIMEOUT_MS=120000

# Optional: slow the mock stream (ms per token) for a more realistic dev feel.
# MOCK_STREAM_DELAY_MS=12

# ---- Ollama (local dev provider — Phase 2) ----
# To use local models: set AI_DEFAULT_PROVIDER=ollama, start Ollama, and pull a model.
OLLAMA_BASE_URL=http://localhost:11434
# The Ollama model tag to use. Small, sensible dev default; override freely.
OLLAMA_MODEL=llama3.2:3b
# Hard timeout for a single generation request (ms).
OLLAMA_REQUEST_TIMEOUT_MS=120000

# ---- OpenAI-compatible provider (production vLLM / RunPod — Phase 3) ----
# Generic OpenAI-compatible chat-completions endpoint. Works with vLLM, RunPod-
# hosted vLLM, self-hosted vLLM, etc. RunPod is just a base URL — no vendor code.
# To activate: set AI_DEFAULT_PROVIDER=openai-compatible and fill these in.
# The base URL is the server root OR its /v1 form; the gateway handles both.
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint.example.com
# The API key is SERVER-SIDE ONLY and never logged. Omit for unauthenticated private endpoints.
# OPENAI_COMPATIBLE_API_KEY=replace-with-provider-key
# The provider's actual model name (e.g. Qwen/Qwen2.5-7B-Instruct). Hidden from the UI.
# OPENAI_COMPATIBLE_MODEL=
# Per-request timeout (ms) and conservative connection retries (setup only).
# OPENAI_COMPATIBLE_REQUEST_TIMEOUT_MS=120000
# OPENAI_COMPATIBLE_MAX_RETRIES=1

# ---- Optional provider fallback (DISABLED by default) ----
# Never silent, never loops, never mid-stream. Requires explicit configuration.
# Do NOT point this at a paid provider unless you intend the cost.
# NOTE: fallback is now primarily configured in the DB (Admin → AI Control). These
# env vars remain as a fallback/legacy toggle.
AI_FALLBACK_ENABLED=false
# AI_FALLBACK_PROVIDER=ollama
# AI_FALLBACK_MODEL=biina-local

# ---- Usage metering & cost controls (Phase 5) ----
# Feature switches. Business RULES (plan limits, budget thresholds) live in the
# DB / admin control plane, NOT here — only these on/off switches are env.
USAGE_METERING_ENABLED=true
COST_TRACKING_ENABLED=true
BUDGET_CONTROLS_ENABLED=true

# ---- Payments & subscriptions (Phase 7) ----
# TWO independent safety switches gate real money. Both default OFF, and live
# mode is NEVER inferred from the mere presence of keys.
#   BILLING_ENABLED   → checkout / portal / provider writes are allowed at all.
#                       With false, the pricing page still renders but checkout is off.
#   BILLING_LIVE_MODE → talk to the provider in LIVE mode (real charges). Requires
#                       BILLING_LIVE_MODE=true AND an sk_live_ key. Keep false for test.
BILLING_ENABLED=false
BILLING_LIVE_MODE=false
BILLING_PROVIDER=stripe
# Days of grace access after a failed renewal (PAST_DUE) before access is pulled.
BILLING_GRACE_DAYS=3

# Stripe keys — SERVER-SIDE ONLY (except the publishable key). Use TEST keys
# (sk_test_ / pk_test_) until live activation is explicitly approved. Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: seed commercial prices from Stripe price ids (else placeholder test ids are seeded).
# These are NON-secret provider price ids, never treated as BIINA plan ids.
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_BUSINESS_ANNUAL=

# Absolute base URL for building checkout/portal return links (falls back to APP_URL).
# APP_BASE_URL=https://app.biina.ai

# ---- Seed data (optional, local only) ----
# SEED_ADMIN_EMAIL=admin@biina.local
# SEED_ADMIN_PASSWORD=change-me
# SEED_USER_EMAIL=user@biina.local
# SEED_USER_PASSWORD=change-me
