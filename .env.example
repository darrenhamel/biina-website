# ==========================================================================
# BIINA.ai — example environment. Copy to `.env` and fill in.
# `.env*` files are git-ignored. NEVER commit real secrets.
# All AI provider credentials are SERVER-SIDE ONLY and never reach the browser.
# ==========================================================================

# ---- Core ----
NODE_ENV=development

# ---- Database (Postgres) ----
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://biina:biina@localhost:5432/biina

# ---- Auth ----
# Used to sign/verify sessions. Generate a long random value for real envs:
#   openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string

# ---- App URLs & email (Phase 6 — identity) ----
# Absolute base URL of the product app. Used to build verification / reset /
# invitation links in emails. If unset, links are derived from the request host.
# APP_URL=https://app.biina.ai

# Email provider abstraction. Identity flows depend only on the interface, never
# on a specific vendor. 'dev' logs a REDACTED email server-side (no real sending)
# and, outside production, surfaces the action link for local testing.
# Future adapters (smtp / resend / ses) drop in without touching callers.
EMAIL_PROVIDER=dev
# Safety valve: the dev provider and dev-link API responses hide token-bearing
# links in production. Set to 'true' ONLY in a trusted staging env to expose them.
# EMAIL_DEV_LINKS=false

# ---- AI Gateway ----
# Which provider the gateway uses by default:
#   mock              — built-in development stub (no external services; zero-config default)
#   ollama            — local models via Ollama (Phase 2). Requires Ollama running.
#   openai-compatible — remote OpenAI-compatible endpoint, e.g. vLLM on RunPod (Phase 3).
# Switching this value is the ONLY change needed to move local ↔ cloud. No frontend change.
AI_DEFAULT_PROVIDER=mock
# Optional. Logical model id from the registry:
#   biina-dev = mock · biina-local = ollama · biina-general = openai-compatible
# If unset, the gateway picks the first enabled model for AI_DEFAULT_PROVIDER.
# AI_DEFAULT_MODEL=biina-dev

# Optional global outer request timeout (ms). Providers also enforce their own.
# AI_REQUEST_TIMEOUT_MS=120000

# Optional: slow the mock stream (ms per token) for a more realistic dev feel.
# MOCK_STREAM_DELAY_MS=12

# ---- Ollama (local dev provider — Phase 2) ----
# To use local models: set AI_DEFAULT_PROVIDER=ollama, start Ollama, and pull a model.
OLLAMA_BASE_URL=http://localhost:11434
# The Ollama model tag to use. Small, sensible dev default; override freely.
OLLAMA_MODEL=llama3.2:3b
# Hard timeout for a single generation request (ms).
OLLAMA_REQUEST_TIMEOUT_MS=120000

# ---- OpenAI-compatible provider (production vLLM / RunPod — Phase 3) ----
# Generic OpenAI-compatible chat-completions endpoint. Works with vLLM, RunPod-
# hosted vLLM, self-hosted vLLM, etc. RunPod is just a base URL — no vendor code.
# To activate: set AI_DEFAULT_PROVIDER=openai-compatible and fill these in.
# The base URL is the server root OR its /v1 form; the gateway handles both.
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint.example.com
# The API key is SERVER-SIDE ONLY and never logged. Omit for unauthenticated private endpoints.
# OPENAI_COMPATIBLE_API_KEY=replace-with-provider-key
# The provider's actual model name (e.g. Qwen/Qwen2.5-7B-Instruct). Hidden from the UI.
# OPENAI_COMPATIBLE_MODEL=
# Per-request timeout (ms) and conservative connection retries (setup only).
# OPENAI_COMPATIBLE_REQUEST_TIMEOUT_MS=120000
# OPENAI_COMPATIBLE_MAX_RETRIES=1

# ---- Optional provider fallback (DISABLED by default) ----
# Never silent, never loops, never mid-stream. Requires explicit configuration.
# Do NOT point this at a paid provider unless you intend the cost.
# NOTE: fallback is now primarily configured in the DB (Admin → AI Control). These
# env vars remain as a fallback/legacy toggle.
AI_FALLBACK_ENABLED=false
# AI_FALLBACK_PROVIDER=ollama
# AI_FALLBACK_MODEL=biina-local

# ---- Usage metering & cost controls (Phase 5) ----
# Feature switches. Business RULES (plan limits, budget thresholds) live in the
# DB / admin control plane, NOT here — only these on/off switches are env.
USAGE_METERING_ENABLED=true
COST_TRACKING_ENABLED=true
BUDGET_CONTROLS_ENABLED=true

# ---- Payments & subscriptions (Phase 7) ----
# TWO independent safety switches gate real money. Both default OFF, and live
# mode is NEVER inferred from the mere presence of keys.
#   BILLING_ENABLED   → checkout / portal / provider writes are allowed at all.
#                       With false, the pricing page still renders but checkout is off.
#   BILLING_LIVE_MODE → talk to the provider in LIVE mode (real charges). Requires
#                       BILLING_LIVE_MODE=true AND an sk_live_ key. Keep false for test.
BILLING_ENABLED=false
BILLING_LIVE_MODE=false
BILLING_PROVIDER=stripe
# Days of grace access after a failed renewal (PAST_DUE) before access is pulled.
BILLING_GRACE_DAYS=3

# Stripe keys — SERVER-SIDE ONLY (except the publishable key). Use TEST keys
# (sk_test_ / pk_test_) until live activation is explicitly approved. Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: seed commercial prices from Stripe price ids (else placeholder test ids are seeded).
# These are NON-secret provider price ids, never treated as BIINA plan ids.
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_BUSINESS_ANNUAL=

# Absolute base URL for building checkout/portal return links (falls back to APP_URL).
# APP_BASE_URL=https://app.biina.ai

# ---- Files, knowledge & RAG (Phase 8) ----
# RAG is on by default; per-plan entitlements still gate access. Set false to disable globally.
RAG_ENABLED=true

# File storage abstraction. 'local' writes OUTSIDE any public dir and is read only
# through server code (keys/paths never exposed). S3/R2/Azure adapters slot in later.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_PATH=.data/uploads
# S3-compatible (future; not provisioned automatically):
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Embedding provider abstraction. 'deterministic' is a cheap, local, dependency-free
# dev embedder (functional lexical similarity, runs anywhere). Real deployments use
# 'ollama' (needs an installed embedding model) or 'openai-compatible' (vLLM/cloud).
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=biina-dev-embed
EMBEDDING_DIMENSIONS=256
# For 'openai-compatible' embeddings (server-side only, never logged):
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Vector store abstraction. 'portable' keeps embeddings in Postgres (jsonb) and needs
# NO extension — runs anywhere. A pgvector deployment sets VECTOR_STORE=pgvector after
# provisioning the extension + vector column (see docs/VECTOR_STORAGE.md).
VECTOR_STORE=portable

# Retrieval + chunking knobs (safe defaults; admins/env can tune).
# RAG_TOP_K=6
# RAG_MIN_SCORE=0.15
# RAG_MAX_CONTEXT_TOKENS=2000
# RAG_CHUNK_SIZE=1200
# RAG_CHUNK_OVERLAP=150

# ---- Web search & live grounding (Phase 9) ----
# OFF by default; per-plan entitlements gate access even when enabled globally.
# All public-web access goes through Biina.ai server components (SSRF-guarded) —
# the LLM never browses directly.
WEB_SEARCH_ENABLED=false
# 'mock' (default; no key, deterministic) or 'generic' (fetch-based JSON search API).
WEB_SEARCH_PROVIDER=mock
# Real provider config (server-side only, never exposed). For WEB_SEARCH_PROVIDER=generic:
# WEB_SEARCH_API_URL=
# WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_DEFAULT_LANGUAGE=en
# WEB_SEARCH_DEFAULT_COUNTRY=
WEB_SEARCH_DEFAULT_SAFE_MODE=strict
WEB_MAX_QUERIES=1

# Safe page-fetch limits (SSRF protection is NOT configurable — it is always on).
WEB_MAX_PAGES_FETCHED=4
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_TIMEOUT_MS=8000
WEB_GROUNDING_BUDGET_MS=20000
WEB_FETCH_CONCURRENCY=3
# WEB_FETCH_USER_AGENT=BIINA-WebGrounding/1.0 (+https://biina.ai/bot)

# ---- Connectors & external integrations (Phase 10) ----
# Encryption key for connector OAuth tokens / API keys (AES-256-GCM). REQUIRED to
# use connectors. Use a 32-byte base64 value; generate ONE and keep it stable —
# a new key on restart orphans every stored credential. Never commit it.
#   openssl rand -base64 32
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=
# Explicit OAuth redirect URI (must match the provider's configured value).
# CONNECTOR_OAUTH_REDIRECT_URI=https://app.biina.ai/api/connectors/callback
# WRITE/side-effecting connector actions (send email, create event, delete file)
# are DISABLED by default and NOT autonomous. Keep false in Phase 10.
CONNECTOR_WRITE_ACTIONS_ENABLED=false
# Google OAuth (server-side only). Real Google connectors stay disabled until set.
# See docs/CONNECTOR_ACTIVATION_CHECKLIST.md.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Agent engine & safe tool execution (Phase 11) ----
# The agent is bounded + human-supervised: the model PROPOSES, BIINA authorizes,
# executes, limits, and audits. Reads run live; writes run on the MOCK adapter by
# default. Real external writes require live connector write scopes AND the write
# switch below AND the manual steps in docs/AGENT_ACTIVATION_CHECKLIST.md.
#
# Master kill switch. false = the platform stops accepting NEW agent runs.
AGENT_EXECUTION_ENABLED=true
# Global write kill switch. false (DEFAULT, safe) = NO external write executes, even
# if approved; reads still work. Only true enables real side-effecting writes.
AGENT_WRITE_ACTIONS_ENABLED=false
# Dry-run: plan + preview + safe reads, but NEVER execute a write.
AGENT_DRY_RUN=false
# Per-tool kill switch (comma-separated tool ids), e.g. "gmail.send,slack.post".
# AGENT_DISABLED_TOOLS=
# Default steps seeded for a session (plan cap may lower it).
AGENT_MAX_STEPS_DEFAULT=8
# Hard ceiling on steps per run — the model can never raise it.
AGENT_MAX_STEPS_HARD_LIMIT=20
# Wall-clock deadline for a single run (ms).
AGENT_MAX_RUNTIME_MS=120000
# How long a pending approval stays valid (ms). Default 900000 = 15 minutes.
AGENT_APPROVAL_TTL_MS=900000
# Optional per-turn LLM cost estimate added to a run's estimated cost (labelled an
# estimate, drives the per-run budget; not a billing figure). Default 0.
# AGENT_ESTIMATED_TURN_COST=0

# ---- Workflows, scheduled automations & reusable agents (Phase 12) ----
# A workflow is a saved agent-run configuration on a trigger. Every run is an ordinary
# Phase 11 agent run and passes the SAME gates — scheduling grants NO new permissions.
# The DATABASE is the authoritative scheduler; a worker advances it via the tick
# endpoint below. Scheduled READ automations run unattended; scheduled WRITES require
# BOTH a narrow standing authorization AND the (default-off) switch below, on top of
# AGENT_WRITE_ACTIONS_ENABLED. See docs/WORKFLOWS.md, docs/SCHEDULER.md,
# docs/AUTOMATION_SECURITY.md.
#
# Master kill switch. false = stop ALL workflow execution (new + scheduled).
WORKFLOWS_ENABLED=true
# Scheduler switch. false = stop scheduled/condition runs; manual runs still allowed.
WORKFLOW_SCHEDULER_ENABLED=true
# Condition-triggered runs. false = stop condition polling.
WORKFLOW_CONDITION_TRIGGERS_ENABLED=true
# Global gate on SCHEDULED external writes — SEPARATE from AGENT_WRITE_ACTIONS_ENABLED
# and OFF by default (safe). Scheduled reads keep working while this is false; a
# scheduled write is BLOCKED unless this is true (and a matching standing authorization
# exists, and AGENT_WRITE_ACTIONS_ENABLED=true).
WORKFLOW_SCHEDULED_WRITES_ENABLED=false
# Per-tool automation kill switch (comma-separated tool ids), e.g. "gmail.send".
# WORKFLOW_DISABLED_TOOLS=
# Absolute per-run step ceiling; overrides workflow/plan limits.
WORKFLOW_MAX_HARD_STEPS=20
# Minimum condition-poll interval (minutes) — no second-by-second polling.
WORKFLOW_MIN_CHECK_INTERVAL_MINUTES=15
# Missed scheduled instants to run after downtime (catch-up limit).
WORKFLOW_MAX_CATCHUP_RUNS=1
# Recover runs stuck in RUNNING past this heartbeat age (ms). Default 600000 = 10 min.
WORKFLOW_STUCK_TIMEOUT_MS=600000
# Shared secret the scheduler worker sends (x-workflow-tick-secret) to call the tick
# endpoint; compared in constant time. UNSET (default) = the tick endpoint is DISABLED
# (returns 503) so it can never be triggered anonymously. Set a strong random value to
# enable scheduling, and point a durable cron/worker at POST /api/internal/workflows/tick.
# WORKFLOW_TICK_SECRET=

# ---- Seed data (optional, local only) ----
# SEED_ADMIN_EMAIL=admin@biina.local
# SEED_ADMIN_PASSWORD=change-me
# SEED_USER_EMAIL=user@biina.local
# SEED_USER_PASSWORD=change-me
