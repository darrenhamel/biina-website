# ==========================================================================
# BIINA.ai — example environment. Copy to `.env` and fill in.
# `.env*` files are git-ignored. NEVER commit real secrets.
# All AI provider credentials are SERVER-SIDE ONLY and never reach the browser.
# ==========================================================================

# ---- Core ----
NODE_ENV=development

# ---- Database (Postgres) ----
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://biina:biina@localhost:5432/biina

# ---- Auth ----
# Used to sign/verify sessions. Generate a long random value for real envs:
#   openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string

# ---- AI Gateway ----
# Phase 1 uses the built-in mock provider. Phase 2 wires the real ones below.
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL=biina-dev

# Optional: slow the mock stream (ms per token) for a more realistic dev feel.
# MOCK_STREAM_DELAY_MS=12

# ---- Ollama (local dev provider — enabled in Phase 3) ----
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ---- OpenAI-compatible provider (production vLLM/RunPod — Phase 6/7) ----
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# ---- Seed data (optional, local only) ----
# SEED_ADMIN_EMAIL=admin@biina.local
# SEED_ADMIN_PASSWORD=change-me
# SEED_USER_EMAIL=user@biina.local
# SEED_USER_PASSWORD=change-me
